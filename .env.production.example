# ==============================================================================
# MONEFIN FRONTEND — PRODUCTION / VERCEL ENVIRONMENT TEMPLATE
# ==============================================================================
# Salin nilai-nilai ini ke Vercel Dashboard:
# Project Settings -> Environment Variables (pilih target: Production & Preview)
# JANGAN commit file .env.local yang berisi credential asli ke GitHub!
# ==============================================================================

# 1. URL Backend API Publik
# Arahkan ke domain publik backend Laravel Anda.
# Contoh jika backend di Railway:
# NEXT_PUBLIC_API_URL=https://monefin-api.up.railway.app/api
# Contoh jika menggunakan subdomain custom:
# NEXT_PUBLIC_API_URL=https://api.monefin.web.id/api
NEXT_PUBLIC_API_URL=https://api.monefin.web.id/api

# 2. ExchangeRate-API Key (Opsional)
# API key untuk auto-update kurs mata uang real-time.
# Jika dikosongkan, MoneFin otomatis menggunakan fallback API v4 gratis.
NEXT_PUBLIC_EXCHANGE_RATE_API_KEY=
